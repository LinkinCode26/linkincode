PORT=3000
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<nombre_db>?retryWrites=true&w=majority
JWT_SECRET=<un valor largo y aleatorio>

# Configuración del servidor de correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@empresa.com
SMTP_PASS=tu-contraseña-o-app-password

# Direcciones de envío y recepción
EMAIL_FROM="Mi Empresa <contacto@empresa.com>"
TEAM_EMAIL=ventas@empresa.com